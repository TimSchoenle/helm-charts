            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 10001
            runAsNonRoot: true
            runAsUser: 10001
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-cloudflare-access-webhook-redirect
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: tmp
