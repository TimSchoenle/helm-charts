{
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "ALERTS{alertstate=\"firing\", alertname=~\"TeamSpeak.*\", namespace=\"$namespace\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "title": "TeamSpeak dashboards",
      "type": "dashboards",
      "tags": ["teamspeak"],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["teamspeak"],
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "TeamSpeak 3",
  "uid": "teamspeak-ts3exporter",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ts3_serverinfo_online, namespace)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "virtualserver",
        "label": "Virtual server",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(ts3_serverinfo_online{namespace=\"$namespace\"}, virtualserver)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Clients online",
      "description": "Voice clients currently connected. Query clients are counted separately.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(ts3_serverinfo_clients_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"})",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Slot usage",
      "description": "Connected clients as a fraction of the licensed slot limit. New clients are rejected at 100%.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(ts3_serverinfo_clients_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}) / sum(ts3_serverinfo_max_clients{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"})",
          "legendFormat": "slots"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Channels",
      "description": "Channels on the virtual server, permanent and temporary. Without persistence this resets to the default channel on every restart.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(ts3_serverinfo_channels_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"})",
          "legendFormat": "channels"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the virtual server was last started. A sudden drop means a restart.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(ts3_serverinfo_uptime{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"})",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Server online",
      "description": "Whether the virtual server reports itself running. Reachable over ServerQuery but offline usually means an expired licence or an admin stop.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Offline", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "Online", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "min(ts3_serverinfo_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"})",
          "legendFormat": "online"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Clients",
      "description": "Voice clients, query clients and the slot limit on one axis, so a server filling up is visible against the ceiling rather than in isolation.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "ts3_serverinfo_clients_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}",
          "legendFormat": "voice - {{virtualserver}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "ts3_serverinfo_query_clients_online{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}",
          "legendFormat": "query - {{virtualserver}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "ts3_serverinfo_max_clients{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}",
          "legendFormat": "slot limit - {{virtualserver}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Total throughput",
      "description": "All traffic the virtual server sends and receives, including speech, control and keepalive.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_bytes_send_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "sent - {{virtualserver}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_bytes_received_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "received - {{virtualserver}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Speech throughput",
      "description": "Voice payload only. This is the traffic that actually scales with people talking.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_speech_bytes_sent_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "sent - {{virtualserver}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_speech_bytes_received_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "received - {{virtualserver}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "File transfer throughput",
      "description": "Traffic on the file transfer port only: avatars, icons and channel uploads. Unlike speech, this is bursty by nature.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_file_transfer_bytes_sent_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "sent - {{virtualserver}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_serverinfo_file_transfer_bytes_received_total{namespace=\"$namespace\", virtualserver=~\"$virtualserver\"}[$__rate_interval])",
          "legendFormat": "received - {{virtualserver}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Exporter health",
      "description": "ServerQuery command outcomes and data model refresh errors. Anything above zero on the error series means the metrics on this dashboard are stale or partial.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*(failed|errors).*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_client_commands_successful_total{namespace=\"$namespace\"}[$__rate_interval])",
          "legendFormat": "successful"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_client_commands_failed_total{namespace=\"$namespace\"}[$__rate_interval])",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(ts3_exporter_data_model_refresh_errors_total{namespace=\"$namespace\"}[$__rate_interval])",
          "legendFormat": "refresh errors - {{collector}}"
        }
      ]
    }
  ]
}
