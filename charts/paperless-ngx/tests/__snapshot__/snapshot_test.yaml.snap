      PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS: "false"
      PAPERLESS_DB_OPTIONS: sslmode=require
      PAPERLESS_DBENGINE: postgresql
      PAPERLESS_DBHOST: RELEASE-NAME-paperless-ngx-postgresql
