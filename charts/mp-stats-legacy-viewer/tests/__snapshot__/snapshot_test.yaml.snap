                    labelSelector:
                      matchLabels:
                        app.kubernetes.io/instance: RELEASE-NAME
                        app.kubernetes.io/name: mp-stats-legacy-viewer
                    topologyKey: kubernetes.io/hostname
                  weight: 100
          automountServiceAccountToken: false
