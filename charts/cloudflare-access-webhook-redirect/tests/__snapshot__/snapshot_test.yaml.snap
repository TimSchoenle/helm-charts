      name: RELEASE-NAME-cloudflare-access-webhook-redirect
      namespace: NAMESPACE
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: cloudflare-access-webhook-redirect
      template:
        metadata:
