                periodSeconds: 5
                tcpSocket:
                  port: filetransfer
                timeoutSeconds: 3
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
                - mountPath: /var/ts3server
                  name: data
                - mountPath: /var/run/ts3server
                  name: run
                - mountPath: /etc/ts3server/license
                  name: license
                  readOnly: true
          securityContext:
            fsGroup: 9987
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 9987
            runAsNonRoot: true
            runAsUser: 9987
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-teamspeak
          terminationGracePeriodSeconds: 60
          volumes:
            - emptyDir: {}
              name: tmp
            - emptyDir: {}
              name: data
            - emptyDir:
                sizeLimit: 8Mi
              name: run
            - name: license
              secret:
                defaultMode: 288
                items:
                  - key: licensekey.dat
                    path: licensekey.dat
                secretName: ts3-license
