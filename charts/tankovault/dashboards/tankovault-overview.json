{
  "uid": "tankovault-overview",
  "title": "TankoVault Service Overview",
  "description": "Service health for one TankoVault release: liveness, readiness and the dependencies behind it, the request path, the database pool, and the edge policy. The scan pipeline has its own dashboard. Every panel is backed by a metric the services actually emit and, wherever possible, by a recording rule rather than an ad-hoc query; panels that would need a metric nobody emits are absent rather than present and empty.",
  "tags": [
    "tankovault"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(tankovault_build_info, namespace)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{namespace=\"$namespace\", job=~\"api|frontend|control-plane|worker|notifier|sync|challenge-solver|render\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "hide": 0,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "ALERTS{alertstate=\"firing\", alertname=~\"TankoVault.*\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} on {{job}}{{provider}}"
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Replicas answering a scrape",
      "description": "One row per service. A service missing from this panel entirely is not idle, it is gone \u2014 nothing is being scraped for it at all.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:up:count{namespace=\"$namespace\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Readiness",
      "description": "The service's own `service_ready` gauge, minimum across replicas \u2014 one unready replica out of three reads as 0 here, because that is a replica serving errors. No external prober is involved.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:service_ready:min{namespace=\"$namespace\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "table",
      "title": "Dependencies each service can reach",
      "description": "`service_dependency_up`, per service and dependency. This is where a readiness failure is diagnosed: 0 against postgres, nats or redis names the outage directly.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job_dependency:service_dependency_up:min{namespace=\"$namespace\"}",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": false,
              "namespace": true
            },
            "renameByName": {
              "job": "Service",
              "dependency": "Dependency",
              "Value": "Up"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Versions running",
      "description": "Distinct `tankovault_build_info` versions. Anything but 1 is a rollout that has not converged; the services share one migrated schema, so a mixed fleet is supported but not meant to persist.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace:tankovault_versions:count{namespace=\"$namespace\"}",
          "legendFormat": "versions",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 6,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Request path",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Successful and failed alike; the error split is the panel beside it.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_requests:rate5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "5xx ratio by service",
      "description": "Server-side faults only. Every client-side outcome in this API is a 4xx, so a healthy deployment sits at zero rather than inside an error budget.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_requests_server_errors:ratio_rate5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Latency quantiles by service",
      "description": "Computed from summed buckets, so these are comparable across replicas \u2014 quantiles cannot be averaged, buckets can.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_request_duration_seconds:p50_5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_request_duration_seconds:p95_5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_request_duration_seconds:p99_5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} p99"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest routes (p95, /v1/me/stream excluded)",
      "description": "The SSE route is excluded because a server-closed stream records its whole lifetime as one request duration and poisons every quantile for the api job.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, namespace_job_route:http_request_duration_seconds:p95_5m{namespace=\"$namespace\", job=~\"$job\"})",
          "legendFormat": "{{job}} {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "5xx by route",
      "description": "Where to start when the ratio panel above goes red. Pair the route with `x-request-id` from the JSON logs to get the full span.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, namespace_job_route:http_requests_server_errors:rate5m{namespace=\"$namespace\", job=~\"$job\"} > 0)",
          "legendFormat": "{{job}} {{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Concurrent requests in flight",
      "description": "Rising while throughput stays flat is queueing, which on this stack means the database pool. Every open /v1/me/stream counts here for as long as the tab is open, so on api and frontend this tracks signed-in browsers as much as load.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_requests_in_flight:avg{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Client-side outcomes",
      "description": "Kept apart from the 5xx panel because none of these is a defect: a 429 is the rate limiter enforcing policy and a 404 can be a switched-off feature, so folding them into one error line would make a working control read as a broken service.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_requests_client_errors:rate5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} 4xx"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:http_requests_throttled:rate5m{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} 429"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Database",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connection pool saturation",
      "description": "In-use connections over the configured maximum, summed across replicas. Sustained above 0.9 is the cause behind most \"everything is slow at once\" incidents here.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:db_pool_saturation:ratio{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "id": 16,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Pool connections by state",
      "description": "Idle collapsing to zero while in-use flattens at the ceiling is exhaustion; both moving together is just traffic.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job_state:db_pool_connections:sum{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}} {{state}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 17,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Live notification streams",
      "description": "Open /v1/me/stream connections. These are the subscribers a NATS slow-consumer drop costs a live push.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "namespace_job:sse_streams_active:sum{namespace=\"$namespace\", job=~\"$job\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "id": 18,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 41
      },
