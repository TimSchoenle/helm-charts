{
  "terrace_contract": 1,
  "app": {
    "name": "foreign",
    "version": "1.0.0"
  },
  "schema": {
    "schema_version": 1,
    "dialect": {
      "prefix": "OTHER_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "FIXTURE_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer.",
        "default": "config.toml"
      },
      {
        "env": "FIXTURE_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "database.url",
        "env": "FIXTURE_DATABASE__URL",
        "env_file": "FIXTURE_DATABASE__URL_FILE",
        "secrets_file": "database__url",
        "docs": "The database.url setting.",
        "ty": "String",
        "text_form": "text",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_constraint": null,
        "aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": true,
        "secret": true,
        "reserved": false
      }
    ]
  },
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "fixture configuration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "database": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "external": {
    "env": [],
    "ignore": [
      "KUBERNETES_*"
    ],
    "unknown": "reject"
  }
}
