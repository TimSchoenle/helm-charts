              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - valkey-cli
                    - ping
                failureThreshold: 5
                periodSeconds: 30
                timeoutSeconds: 5
              name: valkey
              ports:
                - containerPort: 6379
                  name: valkey
                  protocol: TCP
              readinessProbe:
                exec:
                  command:
                    - valkey-cli
                    - ping
                failureThreshold: 3
                periodSeconds: 10
                timeoutSeconds: 3
              resources:
                limits:
                  memory: 256Mi
                requests:
                  cpu: 50m
                  memory: 128Mi
              securityContext:
                allowPrivilegeEscalation: false
