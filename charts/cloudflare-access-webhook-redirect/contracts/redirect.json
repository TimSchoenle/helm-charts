{
  "contract": {
    "app": {
      "name": "cloudflare-access-webhook-redirect",
      "source": "https://github.com/TimSchoenle/cloudflare-access-webhook-redirect",
      "version": "v2.3.6"
    },
    "external": {
      "env": [
        {
          "constraint": {
            "type": "string"
          },
          "docs": "Proxy for event submission over HTTP. Read only while `telemetry.sentry.enabled` is set.",
          "name": "HTTP_PROXY",
          "owner": "the Sentry SDK",
          "required": false,
          "secret": false,
          "text_form": "text",
          "ty": "String",
          "values": []
        },
        {
          "constraint": {
            "type": "string"
          },
          "docs": "Proxy for event submission over HTTPS; falls back to `HTTP_PROXY`. Read only while `telemetry.sentry.enabled` is set.",
          "name": "HTTPS_PROXY",
          "owner": "the Sentry SDK",
          "required": false,
          "secret": false,
          "text_form": "text",
          "ty": "String",
          "values": []
        },
        {
          "constraint": {
            "type": "boolean"
          },
          "docs": "`false` submits events without verifying the ingest endpoint's certificate. Leave unset.",
          "name": "SSL_VERIFY",
          "owner": "the Sentry SDK",
          "required": false,
          "secret": false,
          "text_constraint": {
            "pattern": "^\\s*(true|false)\\s*$",
            "type": "string"
          },
          "text_form": "boolean",
          "ty": "bool",
          "values": []
        }
      ],
      "ignore": [
        "HOSTNAME",
        "KUBERNETES_*",
        "TZ"
      ],
      "unknown": "reject"
    },
    "json_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "cloudflare": {
          "additionalProperties": false,
          "properties": {
            "client_id": {
              "description": "`CF-Access-Client-Id` header value.",
              "type": "string",
              "writeOnly": true
            },
            "client_secret": {
              "description": "`CF-Access-Client-Secret` header value.",
              "type": "string",
              "writeOnly": true
            }
          },
          "type": "object"
        },
        "server": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "127.0.0.1",
              "description": "Bind address. Containers usually want `0.0.0.0`.",
              "type": "string"
            },
            "port": {
              "default": 8080,
              "description": "Bind port.",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "telemetry": {
          "additionalProperties": false,
          "properties": {
            "log_level": {
              "default": "info",
              "description": "Minimum level emitted by the subscriber.\n\nRead as a [`LogLevel`] rather than as a `tracing` type so an unusable value fails the\nboot with a configuration error naming the key, instead of after the subscriber is\ninstalled — and so the spellings this key takes are the ones the settings table lists.",
              "enum": [
                "error",
                "warn",
                "info",
                "debug",
                "trace"
              ],
              "type": "string"
            },
            "sentry": {
              "additionalProperties": false,
              "properties": {
                "attach_stacktraces": {
                  "default": true,
                  "description": "Attach a stack trace to events that carry none of their own.",
                  "type": "boolean"
                },
                "breadcrumb_level": {
                  "default": "info",
                  "description": "Least severe `tracing` level kept as a **breadcrumb** — the trail attached to the next\nissue. Same spellings as `capture_level`; records at or above it become issues instead.",
                  "enum": [
                    "off",
                    "error",
                    "warn",
                    "info",
                    "debug",
                    "trace"
                  ],
                  "type": "string"
                },
                "capture_level": {
                  "default": "error",
                  "description": "Least severe `tracing` level reported as a Sentry **issue**: `off`, `error`, `warn`,\n`info`, `debug` or `trace`.\n\nBounded from above by `telemetry.log_level`: the Sentry layer sits under the same filter\nthe console log does, so a record that level drops is never reported either.",
                  "enum": [
                    "off",
                    "error",
                    "warn",
                    "info",
                    "debug",
                    "trace"
                  ],
                  "type": "string"
                },
                "debug": {
                  "default": false,
                  "description": "Print the SDK's own diagnostics to stderr. For proving a DSN works, not for running.",
                  "type": "boolean"
                },
                "dsn": {
                  "description": "Ingest URL, `https://<key>@<host>/<project>`.\n\nA [`SecretString`]: the embedded key is a bearer credential for the project's ingest\nendpoint. Absent while `enabled` is set fails the boot rather than reporting nowhere.",
                  "type": "string",
                  "writeOnly": true
                },
                "enabled": {
                  "default": false,
                  "description": "Initialise the Sentry client. `false` installs no client, no panic hook, no `tracing`\nlayer and no HTTP middleware, so every other key here is inert and nothing is sent\nanywhere.",
                  "type": "boolean"
                },
                "environment": {
                  "default": "production",
                  "description": "Environment tag on every event, such as `production` or `staging`.\n\nHas a default rather than being optional so the field is never empty when the SDK's own\ndefaults run: an unset `environment` is the one field they would fill from\n`SENTRY_ENVIRONMENT`, which is a second configuration channel that bypasses the layered\nloader and its shadow-key rejection. `release` and `dsn` are always set for the same\nreason.",
                  "type": "string"
                },
                "http_transactions": {
                  "default": true,
                  "description": "Record one Sentry transaction per request, named by the method and the matched path.\n\nWhether a started transaction is *kept* is `traces_sample_rate`'s decision. This is the\nswitch for a deployment that should stay out of traces entirely while still reporting\nerrors.",
                  "type": "boolean"
                },
                "max_breadcrumbs": {
                  "default": 100,
                  "description": "How many breadcrumbs one event carries.",
                  "minimum": 0,
                  "type": "integer"
                },
                "release": {
                  "description": "Release tag on every event. Defaults to the crate name and version the binary was built\nfrom, which is what makes a regression attributable to a deploy.",
                  "type": "string"
                },
                "sample_rate": {
                  "default": 1.0,
                  "description": "Fraction of captured events actually sent, `0.0`-`1.0`. A blunt volume cap — it drops\nwhole issues, not repetitions of one — so leave it at `1.0` unless quota forces it.",
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "send_default_pii": {
                  "default": false,
                  "description": "Send personally identifying data with every event: the client IP, the full request header\nset, and request bodies of a known content type.\n\n**Off, and worth leaving off.** Every header this proxy receives is forwarded to a\nCloudflare Access protected service, so the header set of a webhook delivery routinely\ncarries the caller's own signing secret — which is exactly what a crash report does not\nneed in order to be actionable.",
                  "type": "boolean"
                },
                "server_name": {
                  "description": "Host tag on every event. Left unset, Sentry reports none: the hostname of a replica is\ninfrastructure detail that `send_default_pii` would otherwise gate.",
                  "type": "string"
                },
                "shutdown_timeout_secs": {
                  "default": 2,
                  "description": "How long process exit waits for queued events to drain.",
                  "minimum": 0,
                  "type": "integer"
                },
                "span_attributes": {
                  "default": false,
                  "description": "Copy `tracing` span fields onto the Sentry span as attributes. Off: the request span this\nproxy opens carries the full request path, and a transaction is stored under a longer\nretention than a log line.",
                  "type": "boolean"
                },
                "traces_sample_rate": {
                  "default": 0.0,
                  "description": "Fraction of traces this proxy **starts** that are recorded, `0.0`-`1.0`.\n\n`0.0` (the default) means it starts none of its own. It does **not** mean the proxy is\nabsent from a trace: a request arriving with a `sentry-trace` header already sampled is\ncontinued regardless, which is what keeps one webhook delivery readable across the\ncaller, this hop and the Cloudflare Access protected service behind it.",
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "webhook": {
          "additionalProperties": false,
          "properties": {
            "paths": {
              "additionalProperties": {
                "items": {
                  "enum": [
                    "ALL",
                    "all",
                    "GET",
                    "get",
                    "POST",
                    "post",
                    "PUT",
                    "put",
                    "PATCH",
                    "patch",
                    "DELETE",
                    "delete"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "description": "Path regex to the methods allowed on it.\n\nA table rather than the packed string the environment layer forced, so a pattern\ncontaining the old separators is no longer unspellable:\n\n```toml\n[webhook.paths]\n\"/webhook/.*\" = [\"ALL\"]\n\"/api/public/.*\" = [\"GET\", \"POST\"]\n```",
              "type": "object"
            },
            "target_base": {
              "description": "Base URL of the Cloudflare Access protected service every allowed path is joined onto.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "title": "cloudflare-access-webhook-redirect configuration",
      "type": "object"
    },
