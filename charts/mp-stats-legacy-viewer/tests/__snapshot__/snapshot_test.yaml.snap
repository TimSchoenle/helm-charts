matches the committed Deployment snapshot:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: mp-stats-legacy-viewer
        app.kubernetes.io/version: v0.13.3
        helm.sh/chart: mp-stats-legacy-viewer-1.0.0
      name: RELEASE-NAME-mp-stats-legacy-viewer
      namespace: NAMESPACE
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: mp-stats-legacy-viewer
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: mp-stats-legacy-viewer
            app.kubernetes.io/version: v0.13.3
        spec:
          automountServiceAccountToken: false
          containers:
            - image: timschoenle/mp-stats-legacy-viewer@sha256:0509b22f40e374829a589616281cf5cda882c70c00c8ce4c2498bf3aef5ef0ad
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /health/live
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 10
                timeoutSeconds: 5
              name: mp-stats-legacy-viewer
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  path: /health/ready
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 5
                successThreshold: 1
                timeoutSeconds: 3
              resources:
                limits:
                  memory: 100Mi
                requests:
                  cpu: 25m
                  memory: 100Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                privileged: false
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 12
                httpGet:
                  path: /health/startup
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 5
                timeoutSeconds: 3
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 1000
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 1000
            runAsNonRoot: true
            runAsUser: 1000
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-mp-stats-legacy-viewer
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: tmp
