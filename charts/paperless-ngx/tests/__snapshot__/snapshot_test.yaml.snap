      PAPERLESS_CONSUMER_RECURSIVE: "false"
      PAPERLESS_CONSUMER_STABILITY_DELAY: "5"
      PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS: "false"
      PAPERLESS_DBENGINE: postgresql
      PAPERLESS_DBHOST: RELEASE-NAME-paperless-ngx-postgresql
      PAPERLESS_DBNAME: paperless
      PAPERLESS_DBPORT: "5432"
      PAPERLESS_DBUSER: paperless
      PAPERLESS_EMAIL_HOST: smtp.example.com
      PAPERLESS_EMAIL_PORT: "587"
      PAPERLESS_EMAIL_USE_SSL: "false"
      PAPERLESS_EMAIL_USE_TLS: "true"
      PAPERLESS_ENABLE_UPDATE_CHECK: "false"
      PAPERLESS_FILENAME_FORMAT_REMOVE_NONE: "false"
      PAPERLESS_OCR_CLEAN: clean
      PAPERLESS_OCR_DESKEW: "true"
      PAPERLESS_OCR_LANGUAGE: eng
      PAPERLESS_OCR_MODE: auto
      PAPERLESS_OCR_OUTPUT_TYPE: pdfa
      PAPERLESS_OCR_ROTATE_PAGES: "true"
      PAPERLESS_PROXY_SSL_HEADER: '["HTTP_X_FORWARDED_PROTO","https"]'
      PAPERLESS_SCRATCH_DIR: /tmp/paperless
      PAPERLESS_TASK_WORKERS: "1"
      PAPERLESS_TIKA_ENABLED: "true"
      PAPERLESS_TIKA_ENDPOINT: http://RELEASE-NAME-paperless-ngx-tika:9998
      PAPERLESS_TIKA_GOTENBERG_ENDPOINT: http://RELEASE-NAME-paperless-ngx-gotenberg:3000
      PAPERLESS_TIME_ZONE: UTC
