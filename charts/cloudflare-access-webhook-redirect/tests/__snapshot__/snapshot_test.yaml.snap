                  cpu: 100m
                  memory: 50Mi
                requests:
                  cpu: 10m
                  memory: 35Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                privileged: false
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 30
