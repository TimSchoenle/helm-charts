{
  "terrace_contract": 1,
  "app": {
    "name": "api",
    "version": "1.0.0"
  },
  "schema": {
    "schema_version": 1,
    "dialect": {
      "prefix": "FIXTURE_",
      "nesting_separator": "__",
      "indirection_suffix": "_FILE"
    },
    "loader": [
      {
        "env": "FIXTURE_CONFIG",
        "role": "config",
        "docs": "Names the TOML layer.",
        "default": "config.toml"
      },
      {
        "env": "FIXTURE_SECRETS_DIR",
        "role": "secrets_dir",
        "docs": "Names a directory of key-named files.",
        "default": null
      }
    ],
    "keys": [
      {
        "path": "auth.session_ttl",
        "env": "FIXTURE_AUTH__SESSION_TTL",
        "env_file": "FIXTURE_AUTH__SESSION_TTL_FILE",
        "secrets_file": "auth__session_ttl",
        "docs": "The auth.session_ttl setting.",
        "ty": "u64",
        "text_form": "integer",
        "values": [],
        "constraint": {
          "type": "integer",
          "minimum": 0
        },
        "text_constraint": {
          "type": "string",
          "pattern": "^\\s*\\+?[0-9]+\\s*$"
        },
        "aliases": [],
        "default": "3600",
        "default_value": 3600,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "database.url",
        "env": "FIXTURE_DATABASE__URL",
        "env_file": "FIXTURE_DATABASE__URL_FILE",
        "secrets_file": "database__url",
        "docs": "The database.url setting.",
        "ty": "String",
        "text_form": "text",
        "values": [],
        "constraint": {
          "type": "string"
        },
        "text_constraint": null,
        "aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": true,
        "secret": true,
        "reserved": false
      },
      {
        "path": "log.level",
        "env": "FIXTURE_LOG__LEVEL",
        "env_file": "FIXTURE_LOG__LEVEL_FILE",
        "secrets_file": "log__level",
        "docs": "The log.level setting.",
        "ty": "Level",
        "text_form": "choice",
        "values": [
          "debug",
          "info",
          "warn"
        ],
        "constraint": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn"
          ]
        },
        "text_constraint": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn"
          ]
        },
        "aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      },
      {
        "path": "github.repos",
        "env": "FIXTURE_GITHUB__REPOS",
        "env_file": "FIXTURE_GITHUB__REPOS_FILE",
        "secrets_file": "github__repos",
        "docs": "The github.repos setting.",
        "ty": "Vec<String>",
        "text_form": "structured",
        "values": [],
        "constraint": {
          "type": "array"
        },
        "text_constraint": null,
        "aliases": [],
        "default": null,
        "default_value": null,
        "note": null,
        "required": false,
        "secret": false,
        "reserved": false
      }
    ]
  },
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "fixture configuration",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "auth": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_ttl": {
            "type": "integer",
            "minimum": 0,
            "default": 3600
          }
        }
      },
      "database": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "log": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn"
            ]
          }
        }
      },
      "github": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "external": {
    "env": [
      {
        "name": "PORT",
        "owner": "runtime",
        "docs": "Bind port.",
        "ty": "u16",
        "text_form": "integer",
        "values": [],
        "constraint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "text_constraint": {
          "type": "string",
          "pattern": "^\\s*\\+?[0-9]+\\s*$"
        },
        "default": "8080",
        "required": false,
        "secret": false
      }
    ],
    "ignore": [
      "KUBERNETES_*"
    ],
    "unknown": "reject"
  }
}
