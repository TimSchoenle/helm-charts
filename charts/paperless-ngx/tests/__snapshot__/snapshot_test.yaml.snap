          port: 5432
          protocol: TCP
          targetPort: postgresql
      selector:
        app.kubernetes.io/component: postgresql
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: paperless-ngx
      type: ClusterIP
