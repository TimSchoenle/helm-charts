  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: portfolio
        app.kubernetes.io/version: v2.1.3
        helm.sh/chart: portfolio-3.0.0
      name: RELEASE-NAME-portfolio
      namespace: NAMESPACE
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: portfolio
      template:
        metadata:
          annotations:
            checksum/configmap: 8114b91e2a94634a4fc30c35a5e7d80619da3b75a7a954193f6d7f4f670a3586
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: portfolio
            app.kubernetes.io/version: v2.1.3
        spec:
          automountServiceAccountToken: false
          containers:
            - envFrom:
                - configMapRef:
                    name: RELEASE-NAME-portfolio
              image: timschoenle/portfolio@sha256:722e3ead404823fc5a12b71b9780eb12484c4a560ecce30c2129e3e5c5b456ad
              imagePullPolicy: IfNotPresent
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /api/health
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 10
                timeoutSeconds: 5
              name: portfolio
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 3
                httpGet:
                  path: /api/health
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 5
                successThreshold: 1
                timeoutSeconds: 3
              resources:
                limits:
                  cpu: 250m
                  memory: 128Mi
                requests:
                  cpu: 25m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                privileged: false
                readOnlyRootFilesystem: true
                runAsNonRoot: true
              startupProbe:
                failureThreshold: 12
                httpGet:
                  path: /api/health
                  port: http
                initialDelaySeconds: 1
                periodSeconds: 5
                timeoutSeconds: 3
              volumeMounts:
                - mountPath: /tmp
                  name: tmp
          securityContext:
            fsGroup: 1001
            fsGroupChangePolicy: OnRootMismatch
            runAsGroup: 1001
            runAsNonRoot: true
            runAsUser: 1001
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-portfolio
          terminationGracePeriodSeconds: 30
          volumes:
            - emptyDir: {}
              name: tmp
