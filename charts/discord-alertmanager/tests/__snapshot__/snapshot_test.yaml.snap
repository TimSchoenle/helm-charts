matches the committed snapshot with the AlertmanagerConfig and network policies on:
  1: |
    apiVersion: monitoring.coreos.com/v1alpha1
    kind: AlertmanagerConfig
    metadata:
      labels:
        alertmanagerConfig: platform
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: discord-alertmanager
        app.kubernetes.io/version: 0.0.0
        helm.sh/chart: discord-alertmanager-0.0.0
      name: RELEASE-NAME-discord-alertmanager
      namespace: NAMESPACE
    spec:
      receivers:
        - name: discord-alertmanager
          webhookConfigs:
            - httpConfig:
                authorization:
                  credentials:
                    key: ingest__webhook_token
                    name: RELEASE-NAME-discord-alertmanager
                  type: Bearer
              sendResolved: true
              url: http://RELEASE-NAME-discord-alertmanager.NAMESPACE.svc:80/webhook
      route:
        continue: true
        groupBy:
          - alertname
          - namespace
        groupInterval: 5m
        groupWait: 30s
        receiver: discord-alertmanager
        repeatInterval: 4h
