{
 "terrace_contract": 1,
 "app": {
  "name": "deep",
  "version": "2.0.0"
 },
 "schema": {
  "schema_version": 2,
  "dialect": {
   "prefix": "FIXTURE_",
   "nesting_separator": "__",
   "indirection_suffix": "_FILE"
  },
  "loader": [
   {
    "env": "FIXTURE_CONFIG",
    "role": "config",
    "docs": "Names the TOML layer.",
    "default": "config.toml"
   },
   {
    "env": "FIXTURE_SECRETS_DIR",
    "role": "secrets_dir",
    "docs": "Names a directory of key-named files.",
    "default": null
   }
  ],
  "keys": [
   {
    "path": "routes",
    "env": "FIXTURE_ROUTES",
    "env_file": "FIXTURE_ROUTES_FILE",
    "secrets_file": "routes",
    "docs": "The routes setting.",
    "ty": "Vec<RouteConfig>",
    "text_form": "structured",
    "values": [],
    "constraint": {
     "type": "array",
     "items": {
      "type": "object",
      "description": "One declared route.\n\nWith a second paragraph the chart must not carry.",
      "properties": {
       "name": {
        "type": "string",
        "description": "The route's name."
       },
       "guild_id": {
        "type": "integer",
        "minimum": 0
       },
       "min_severity": {
        "type": "string",
        "enum": [
         "info",
         "warning",
         "critical"
        ]
       },
       "target": {
        "type": "object",
        "properties": {
         "kind": {
          "type": "string",
          "enum": [
           "text",
           "forum"
          ]
         },
         "id": {
          "type": "integer",
          "minimum": 0
         }
        },
        "required": [
         "kind"
        ]
       }
      },
      "required": [
       "name",
       "guild_id"
      ]
     }
    },
    "text_constraint": {
     "type": "string",
     "pattern": "^\\s*(\\[.*\\]|\\{.*\\})\\s*$"
    },
    "aliases": [],
    "default": null,
    "default_value": null,
    "note": null,
    "required": false,
    "secret": false,
    "reserved": false
   },
   {
    "path": "webhook.paths",
    "env": "FIXTURE_WEBHOOK__PATHS",
    "env_file": "FIXTURE_WEBHOOK__PATHS_FILE",
    "secrets_file": "webhook__paths",
    "docs": "The webhook.paths setting.",
    "ty": "HashMap<String, HashSet<Method>>",
    "text_form": "structured",
    "values": [],
    "constraint": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "enum": [
        "GET",
        "POST"
       ]
      }
     }
    },
    "text_constraint": {
     "type": "string",
     "pattern": "^\\s*(\\[.*\\]|\\{.*\\})\\s*$"
    },
    "aliases": [],
    "default": null,
    "default_value": null,
    "note": null,
    "required": false,
    "secret": false,
    "reserved": false
   },
   {
    "path": "github.repos",
    "env": "FIXTURE_GITHUB__REPOS",
    "env_file": "FIXTURE_GITHUB__REPOS_FILE",
    "secrets_file": "github__repos",
    "docs": "The github.repos setting.",
    "ty": "Vec<String>",
    "text_form": "structured",
    "values": [],
    "constraint": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "text_constraint": {
     "type": "string",
     "pattern": "^\\s*(\\[.*\\]|\\{.*\\})\\s*$"
    },
    "aliases": [],
    "default": null,
    "default_value": null,
    "note": null,
    "required": false,
    "secret": false,
    "reserved": false
   },
   {
    "path": "internal.peers",
    "env": "FIXTURE_INTERNAL__PEERS",
    "env_file": "FIXTURE_INTERNAL__PEERS_FILE",
    "secrets_file": "internal__peers",
    "docs": "The internal.peers setting.",
    "ty": "BTreeMap<String, PeerConfig>",
    "text_form": "structured",
    "values": [],
    "constraint": {
     "type": "object"
    },
    "text_constraint": {
     "type": "string",
     "pattern": "^\\s*(\\[.*\\]|\\{.*\\})\\s*$"
    },
    "aliases": [],
    "default": null,
    "default_value": null,
    "note": null,
    "required": false,
    "secret": false,
    "reserved": false
   }
  ]
 },
 "json_schema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "deep configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
   "routes": {
    "type": "array",
    "items": {
     "type": "object",
     "description": "One declared route.\n\nWith a second paragraph the chart must not carry.",
     "properties": {
      "name": {
       "type": "string",
       "description": "The route's name."
      },
      "guild_id": {
       "type": "integer",
       "minimum": 0
      },
      "min_severity": {
       "type": "string",
       "enum": [
        "info",
        "warning",
        "critical"
       ]
      },
      "target": {
       "type": "object",
       "properties": {
        "kind": {
         "type": "string",
         "enum": [
          "text",
          "forum"
         ]
        },
        "id": {
         "type": "integer",
         "minimum": 0
        }
       },
       "required": [
        "kind"
       ]
      }
     },
     "required": [
      "name",
      "guild_id"
     ]
    }
   },
   "webhook": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "paths": {
      "type": "object",
      "additionalProperties": {
       "type": "array",
       "uniqueItems": true,
       "items": {
        "type": "string",
        "enum": [
         "GET",
         "POST"
        ]
       }
      }
     }
    }
   },
   "github": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "repos": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "internal": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "peers": {
      "type": "object"
     }
    }
   }
  }
 },
 "external": {
  "env": [
   {
    "name": "PORT",
    "owner": "runtime",
    "docs": "Bind port.",
    "ty": "u16",
    "text_form": "integer",
    "values": [],
    "constraint": {
     "type": "integer",
     "minimum": 0,
     "maximum": 65535
    },
    "text_constraint": {
     "type": "string",
     "pattern": "^\\s*\\+?[0-9]+\\s*$"
    },
    "default": "8080",
    "required": false,
    "secret": false
   }
  ],
  "ignore": [
   "KUBERNETES_*"
  ],
  "unknown": "reject"
 }
}
